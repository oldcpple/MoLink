# Cluster description for the benchmark kit. Copy to cluster.env, edit,
# then `set -a; . ./cluster.env; set +a` before running anything in kit/.
# No credentials live here: machine B must be reachable with key-based ssh
# ($B_SSH) and both machines need root/passwordless sudo for `tc`.

# --- machine A (stage 0, runs the API server + scheduler + ray head) ---
A_IP=192.0.2.13                 # A's address on the A<->B link
A_IF=eno1                       # A's NIC on that link (tc shaping + NCCL)
GPUS_A=0,1                      # two GPUs on A (CUDA_VISIBLE_DEVICES)
A_VENV=/opt/hetvllm/.venv       # venv with the patched vLLM installed
A_SUDO=""                       # prefix for tc on A ("sudo -n" if not root)

# --- machine B (stage 1) ---
B_IP=192.0.2.15
B_IF=enp1s0
B_SSH="ssh -p 22 user@192.0.2.15"   # key-based, non-interactive
B_VENV=/opt/hetvllm/.venv           # same patched vLLM on B
B_SUDO="sudo -n"                    # prefix for tc on B ('' if root)
# B_NUM_GPUS=1                      # 1+1 GPU runs (Qwen3-8B): limit B's ray node

# --- model (same absolute path on BOTH machines) ---
MODEL_A3B=/data/models/Qwen3-30B-A3B
MODEL_D32=/data/models/Qwen3-32B
MODEL_Q8=/data/models/Qwen3-8B

# --- outputs ---
HET_RESULTS=./results           # replay JSONs, greedy captures, engine.log
PORT=26000
